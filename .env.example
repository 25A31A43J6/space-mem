# GROQ_API_KEY: Required for Groq LLM API calls (server-side only, never exposed to client).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Hindsight Cloud Memory Engine (Optional - Demo mode works automatically if unset)
# Set your Hindsight API key to connect directly to Hindsight Cloud.
HINDSIGHT_API_KEY=""
HINDSIGHT_BASE_URL="https://api.hindsightcloud.com"
HINDSIGHT_BANK_ID="space-mem-engineering"
